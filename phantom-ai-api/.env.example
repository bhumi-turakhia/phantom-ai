NODE_ENV=production
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/phantom-ai

# Cryptographically strong secret for JWT signatures (generate via: openssl rand -hex 64)
JWT_SECRET=replace_with_64_byte_cryptographic_secret
JWT_EXPIRES_IN=7d

# Trusted origins for CORS and WebAuthn (comma-separated, NO wildcards)
CORS_ORIGIN=https://phantom.agency.internal
WEBAUTHN_ORIGIN=https://phantom.agency.internal
WEBAUTHN_RP_ID=phantom.agency.internal
COOKIE_DOMAIN=.agency.internal

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info

# Internal Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=30000
